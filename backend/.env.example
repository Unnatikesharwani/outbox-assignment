PORT=4000
FRONTEND_URL=http://localhost:5173
# Must be https for Slack OAuth (use ngrok / cloudflared in dev) – e.g. https://abcd.ngrok.app
BACKEND_URL=http://localhost:4000
JWT_SECRET=change-me

DATABASE_URL=postgres://postgres:postgres@localhost:5432/scheduler
REDIS_URL=redis://localhost:6379
ELASTICSEARCH_URL=http://localhost:9200

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
# Slack redirect URL must be registered as: {BACKEND_URL}/auth/slack/callback

# ---- throughput / rate limiting ----
WORKER_CONCURRENCY=5
MIN_DELAY_BETWEEN_EMAILS_MS=2000
MAX_EMAILS_PER_HOUR_PER_SENDER=200
SENDER_COUNT=3
RUN_WORKER=true
